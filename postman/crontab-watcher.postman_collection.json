            ]
          }
        }
      ]
    },
    {
      "name": "Get an unknown job (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{unknownJobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{unknownJobId}}"]
        },
        "description": "An identifier that is not in the crontab."
      },
      "event": [
        {
          "listen": "test",
