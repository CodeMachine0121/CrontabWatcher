    {
      "name": "Create with an invalid schedule (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleExpression\": \"{{invalidScheduleExpression}}\",\n  \"command\": \"/bin/true\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["jobs"]
        },
        "description": "Validation happens before the crontab file is opened, so a malformed request causes no I/O at all and cannot leave a partial write."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 400', function () { pm.response.to.have.status(400); });",
              "pm.test('the error names the problem', function () {",
              "    pm.expect(pm.response.json().error).to.include('invalid cron expression');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create with a six-field schedule (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleExpression\": \"0 0 3 * * *\",\n  \"command\": \"/bin/true\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["jobs"]
        },
        "description": "Six-field expressions with a seconds column are refused on purpose. Neither busybox crond nor standard cron accepts them, so taking one would make the displayed next-run time disagree with what actually happens."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 400', function () { pm.response.to.have.status(400); });",
              "pm.test('the error explains the field count', function () {",
              "    pm.expect(pm.response.json().error).to.include('5 fields');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create with a newline in the command (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleExpression\": \"0 3 * * *\",\n  \"command\": \"{{commandWithNewline}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["jobs"]
        },
        "description": "crontab is a one-entry-per-line format. A newline in the command would split one entry into two, and the second line could become a schedule nobody intended."
      },
      "event": [
