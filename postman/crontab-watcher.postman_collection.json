    {
      "name": "Adopt a hand-written job",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/adopt",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{jobId}}", "adopt"]
        },
        "description": "SIDE EFFECT — this permanently rewrites that crontab entry. It is last in the collection for that reason.\n\nWraps the command so runs get a real exit code, and strips the trailing output redirect. Stripping is necessary: leaving it would send stdout away before the wrapper sees it and produce empty records, which is worse than none. The removed fragment is recorded in a marker so it can be restored.\n\nAfter this, output goes to the managed log directory and the original file stops being written to. The previous crontab is in the backup directory.\n\nAnswers 409 if the job is already managed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 409) {",
              "    pm.test('already managed, nothing to adopt', function () {",
              "        pm.expect(pm.response.json().error).to.include('already managed');",
              "    });",
              "    return;",
              "}",
              "",
              "pm.test('responds 200', function () { pm.response.to.have.status(200); });",
              "",
              "const job = pm.response.json();",
              "pm.test('the job is now managed', function () {",
              "    pm.expect(job.origin).to.eql('managed');",
              "    pm.expect(job.logSource).to.eql('managed');",
              "});",
              "pm.test('it received a new identifier', function () {",
              "    pm.expect(job.jobId).to.not.eql(pm.collectionVariables.get('jobId'));",
              "});",
              "pm.test('the command is wrapped', function () {",
              "    pm.expect(job.rawCommand).to.include('run --job=' + job.jobId + ' --');",
              "});"
            ]
          }
        }
      ]
    }
