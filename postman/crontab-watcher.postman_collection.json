    {
      "name": "Tail log with a bad line count (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/log?lines={{invalidLineCount}}",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{jobId}}", "log"],
          "query": [{ "key": "lines", "value": "{{invalidLineCount}}" }]
        },
        "description": "A mistyped query parameter is rejected rather than ignored: silently falling back to the default would let the caller believe their value took effect.\n\nAn excessive but valid number is different — that is clamped, because returning 5000 of the 10000 lines asked for is a usable answer."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 400', function () { pm.response.to.have.status(400); });",
              "pm.test('the error names the parameter', function () {",
              "    pm.expect(pm.response.json().error).to.include('lines');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Tail log of a job with no readable output (409)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/log",
          "host": ["{{baseUrl}}"],
          "path": ["jobs", "{{jobId}}", "log"]
        },
        "description": "Only meaningful when {{jobId}} is a hand-written job whose output goes nowhere or to /dev/null; otherwise this request answers 200 and the assertions below are skipped.\n\nThis is 409 rather than 200 with an empty body on purpose: an empty body reads as 'ran and produced nothing', which is a different fact from 'there is no way for us to know'. The hint names the fix."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 409) {",
              "    pm.test('the reason is stated', function () {",
              "        pm.expect(pm.response.json().error).to.include('job log unavailable');",
              "    });",
              "    pm.test('a next step is suggested', function () {",
              "        pm.expect(pm.response.json().hint).to.include('adopt');",
              "    });",
              "} else {",
              "    pm.test('this job does have a readable log, so 200 is correct', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Job list page",
      "request": {
