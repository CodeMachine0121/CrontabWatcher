# 本機開發用。所有變數皆有預設值，整份 .env 可省略。
# 容器部署的設定走 docker-compose.yml 的 environment，不用這份。

# 監聽位址。預設只綁 loopback —— 本服務可執行任意指令，等同 remote shell。
SERVER_ADDRESS=127.0.0.1:8080

# cron 排程時區，用於計算「下次執行時間」。必須與實際跑 cron 的環境一致。
TZ=Asia/Taipei

# 本機開發時把狀態放在專案內的 ./data，不要碰真的 crontab
CRONTAB_FILE_PATH=./data/crontabs/root
RUN_LOG_DIRECTORY=./data/logs
RUN_RECORD_FILE_PATH=./data/runs.jsonl
CRONTAB_BACKUP_DIRECTORY=./data/backups

CRONTAB_WRITE_ENABLED=true
MANUAL_TRIGGER_ENABLED=true
MANUAL_TRIGGER_TIMEOUT_SECONDS=900

SHELL_PATH=/bin/sh
LOG_TAIL_LINES=200
RUN_RECORD_RETENTION_COUNT=500

# crontab 存取方式。file＝直接讀寫下方 CRONTAB_FILE_PATH（容器自管模式）；
# crontabCommand＝走 `crontab -l` / `crontab <file>`（host 模式必須用這個，因為
# spool 目錄是 root-only，crontab 是唯一不需要 root 的途徑）。
# 用 `make start-host` 時這一項會自動設好，不必寫在這裡。
CRONTAB_SOURCE=file
CRONTAB_COMMAND_PATH=crontab
